   "read_only": 1
  },
  {
   "default": "0",
   "description": "End-of-service benefit is excluded for flexible work / \u0644\u0627 \u062a\u0633\u062a\u062d\u0642 \u0645\u0643\u0627\u0641\u0623\u0629 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u062e\u062f\u0645\u0629 \u0641\u064a \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u0631\u0646",
